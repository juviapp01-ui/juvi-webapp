# Copy to .env and fill in. .env is not committed.
#
# Every VITE_* value is compiled into the built website and readable by anyone
# who loads it. Only public, browser-safe identifiers belong here — never a
# server secret (no Paytm merchant key, no service-account JSON).

# The JUVI backend the website talks to (same API the mobile app uses).
VITE_API_URL=https://your-juvi-api-host

# Firebase web app config — Firebase console → Project settings → Your apps →
# the Web app (</>) for the SAME project the mobile app uses, so the backend
# accepts its ID tokens. Phone sign-in uses invisible reCAPTCHA.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your-firebase-web-app-id
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id

# Optional. Only used to show the place name ("Dimapur") for the browser's
# location on Home; without it the header says "Near You". Needs the
# Geocoding API enabled and the key restricted to the website's domains.
VITE_GOOGLE_MAPS_KEY=

# Not used yet — payments come in a later phase.
VITE_PAYTM_ENV=STAGING
